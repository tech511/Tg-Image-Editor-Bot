# ---- Required ----
BOT_TOKEN=
MONGO_URI=
OWNER_ID=0
LOG_CHANNEL_ID=0

# ---- Optional (Pyrogram-style credentials, not needed by Aiogram) ----
API_ID=0
API_HASH=

# ---- Optional UI (leave empty for text-only pages) ----
UPDATE_CHANNEL_URL=https://t.me/telegram
WELCOME_IMAGE=
HELP_IMAGE=
ABOUT_IMAGE=
# WELCOME_CAPTION=  (supports HTML and {name}; use \n for new lines)
# HELP_CAPTION=
# ABOUT_CAPTION=

# ---- Limits ----
MAX_UPLOAD_MB=10
MAX_IMAGE_PIXELS=16000000
MAX_IMAGE_SIDE=6000
MAX_HISTORY_FRAMES=10
SESSION_TIMEOUT_MIN=15
MAX_CONCURRENT_JOBS=2
JOB_COOLDOWN_SEC=3
PREVIEW_MAX_SIDE=1280
TEMP_DIR=temp_files
